<?xml version="1.0"?>
<!-- Ant (doc 6.1), shaped like the Gym/MuJoCo Ant: ball torso (r 0.25), 4 diagonal legs.
     Each leg: hip (turns around z, +-30 deg), ankle (bends the lower leg down, 30..70 deg).
     Masses as Gym (density 5): 0.91 kg in all. Collision: torso, knees and feet are spheres.
     Leg frames point along the leg (local x), so all four ankles use axis +y and the same range. -->
<robot name="ant">
  <mujoco><compiler fusestatic="false" discardvisual="true" balanceinertia="false"/></mujoco>
  <link name="torso">
    <inertial><origin xyz="0 0 0"/><mass value="0.483"/><inertia ixx="0.0105" ixy="0" ixz="0" iyy="0.0105" iyz="0" izz="0.0110"/></inertial>
    <collision><origin xyz="0 0 0"/><geometry><sphere radius="0.25"/></geometry></collision>
  </link>
  <link name="front_left_thigh">
    <inertial><origin xyz="0.1414 0 0"/><mass value="0.039"/><inertia ixx="0.0001248" ixy="0" ixz="0" iyy="0.000322321" iyz="0" izz="0.000322321"/></inertial>
    <collision><origin xyz="0.2828 0 0"/><geometry><sphere radius="0.08"/></geometry></collision>
  </link>
  <link name="front_left_shin">
    <inertial><origin xyz="0.2828 0 0"/><mass value="0.068"/><inertia ixx="0.0002176" ixy="0" ixz="0" iyy="0.00192223" iyz="0" izz="0.00192223"/></inertial>
    <collision><origin xyz="0.5657 0 0"/><geometry><sphere radius="0.08"/></geometry></collision>
  </link>
  <joint name="front_left_hip" type="revolute">
    <parent link="torso"/><child link="front_left_thigh"/>
    <origin xyz="0.2000 0.2000 0" rpy="0 0 0.785398"/><axis xyz="0 0 1"/>
    <limit lower="-0.5236" upper="0.5236" effort="5" velocity="10"/>
  </joint>
  <joint name="front_left_ankle" type="revolute">
    <parent link="front_left_thigh"/><child link="front_left_shin"/>
    <origin xyz="0.2828 0 0"/><axis xyz="0 1 0"/>
    <limit lower="0.5236" upper="1.2217" effort="5" velocity="10"/>
  </joint>
  <link name="back_left_thigh">
    <inertial><origin xyz="0.1414 0 0"/><mass value="0.039"/><inertia ixx="0.0001248" ixy="0" ixz="0" iyy="0.000322321" iyz="0" izz="0.000322321"/></inertial>
    <collision><origin xyz="0.2828 0 0"/><geometry><sphere radius="0.08"/></geometry></collision>
  </link>
  <link name="back_left_shin">
    <inertial><origin xyz="0.2828 0 0"/><mass value="0.068"/><inertia ixx="0.0002176" ixy="0" ixz="0" iyy="0.00192223" iyz="0" izz="0.00192223"/></inertial>
    <collision><origin xyz="0.5657 0 0"/><geometry><sphere radius="0.08"/></geometry></collision>
  </link>
  <joint name="back_left_hip" type="revolute">
    <parent link="torso"/><child link="back_left_thigh"/>
    <origin xyz="-0.2000 0.2000 0" rpy="0 0 2.356194"/><axis xyz="0 0 1"/>
    <limit lower="-0.5236" upper="0.5236" effort="5" velocity="10"/>
  </joint>
  <joint name="back_left_ankle" type="revolute">
    <parent link="back_left_thigh"/><child link="back_left_shin"/>
    <origin xyz="0.2828 0 0"/><axis xyz="0 1 0"/>
    <limit lower="0.5236" upper="1.2217" effort="5" velocity="10"/>
  </joint>
  <link name="back_right_thigh">
    <inertial><origin xyz="0.1414 0 0"/><mass value="0.039"/><inertia ixx="0.0001248" ixy="0" ixz="0" iyy="0.000322321" iyz="0" izz="0.000322321"/></inertial>
    <collision><origin xyz="0.2828 0 0"/><geometry><sphere radius="0.08"/></geometry></collision>
  </link>
  <link name="back_right_shin">
    <inertial><origin xyz="0.2828 0 0"/><mass value="0.068"/><inertia ixx="0.0002176" ixy="0" ixz="0" iyy="0.00192223" iyz="0" izz="0.00192223"/></inertial>
    <collision><origin xyz="0.5657 0 0"/><geometry><sphere radius="0.08"/></geometry></collision>
  </link>
  <joint name="back_right_hip" type="revolute">
    <parent link="torso"/><child link="back_right_thigh"/>
    <origin xyz="-0.2000 -0.2000 0" rpy="0 0 3.926991"/><axis xyz="0 0 1"/>
    <limit lower="-0.5236" upper="0.5236" effort="5" velocity="10"/>
  </joint>
  <joint name="back_right_ankle" type="revolute">
    <parent link="back_right_thigh"/><child link="back_right_shin"/>
    <origin xyz="0.2828 0 0"/><axis xyz="0 1 0"/>
    <limit lower="0.5236" upper="1.2217" effort="5" velocity="10"/>
  </joint>
  <link name="front_right_thigh">
    <inertial><origin xyz="0.1414 0 0"/><mass value="0.039"/><inertia ixx="0.0001248" ixy="0" ixz="0" iyy="0.000322321" iyz="0" izz="0.000322321"/></inertial>
    <collision><origin xyz="0.2828 0 0"/><geometry><sphere radius="0.08"/></geometry></collision>
  </link>
  <link name="front_right_shin">
    <inertial><origin xyz="0.2828 0 0"/><mass value="0.068"/><inertia ixx="0.0002176" ixy="0" ixz="0" iyy="0.00192223" iyz="0" izz="0.00192223"/></inertial>
    <collision><origin xyz="0.5657 0 0"/><geometry><sphere radius="0.08"/></geometry></collision>
  </link>
  <joint name="front_right_hip" type="revolute">
    <parent link="torso"/><child link="front_right_thigh"/>
    <origin xyz="0.2000 -0.2000 0" rpy="0 0 5.497787"/><axis xyz="0 0 1"/>
    <limit lower="-0.5236" upper="0.5236" effort="5" velocity="10"/>
  </joint>
  <joint name="front_right_ankle" type="revolute">
    <parent link="front_right_thigh"/><child link="front_right_shin"/>
    <origin xyz="0.2828 0 0"/><axis xyz="0 1 0"/>
    <limit lower="0.5236" upper="1.2217" effort="5" velocity="10"/>
  </joint>
</robot>
