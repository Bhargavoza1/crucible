<?xml version="1.0"?>
<!-- Simplest test robot: one link swinging on a hinge (fixed base). -->
<robot name="pendulum">
  <mujoco><compiler fusestatic="false" discardvisual="true" balanceinertia="false"/></mujoco>
  <link name="base">
    <inertial><origin xyz="0 0 0"/><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <link name="arm">
    <inertial><origin xyz="0 0 -0.5"/><mass value="2.0"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.002"/></inertial>
    <collision><origin xyz="0 0 -1.0"/><geometry><sphere radius="0.1"/></geometry></collision>
  </link>
  <joint name="hinge" type="continuous">
    <parent link="base"/><child link="arm"/>
    <origin xyz="0 0 2.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
</robot>
