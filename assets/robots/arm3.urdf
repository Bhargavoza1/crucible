<?xml version="1.0"?>
<!-- Fixed-base arm made to be awkward on purpose: rotated joint frames (rpy),
     a tilted joint axis, a prismatic joint, a fixed joint, off-center and
     rotated inertia frames with off-diagonal terms. Tests every FK detail. -->
<robot name="arm3">
  <mujoco><compiler fusestatic="false" discardvisual="true" balanceinertia="false"/></mujoco>
  <link name="base">
    <inertial><origin xyz="0 0 0.05"/><mass value="3.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.03"/></inertial>
  </link>
  <link name="link1">
    <inertial><origin xyz="0.02 -0.01 0.15" rpy="0.1 0.2 0.3"/><mass value="1.5"/>
      <inertia ixx="0.012" ixy="0.001" ixz="-0.0005" iyy="0.011" iyz="0.0007" izz="0.004"/></inertial>
  </link>
  <link name="link2">
    <inertial><origin xyz="0.2 0.0 0.01" rpy="-0.2 0.0 0.4"/><mass value="1.0"/>
      <inertia ixx="0.002" ixy="-0.0003" ixz="0.0001" iyy="0.015" iyz="0.0" izz="0.014"/></inertial>
    <collision><origin xyz="0.4 0 0"/><geometry><sphere radius="0.05"/></geometry></collision>
  </link>
  <link name="link3">
    <inertial><origin xyz="0.0 0.05 0.1" rpy="0.3 -0.1 0.2"/><mass value="0.7"/>
      <inertia ixx="0.004" ixy="0.0002" ixz="0.0003" iyy="0.003" iyz="-0.0004" izz="0.002"/></inertial>
  </link>
  <link name="tool">
    <inertial><origin xyz="0 0 0.03"/><mass value="0.3"/><inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0002"/></inertial>
    <collision><origin xyz="0 0 0.05"/><geometry><sphere radius="0.03"/></geometry></collision>
  </link>
  <joint name="j1" type="continuous">
    <parent link="base"/><child link="link1"/>
    <origin xyz="0 0 0.1" rpy="0 0 0.5"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="j2" type="prismatic">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0.0 0.0 0.3" rpy="0.4 -0.3 0.1"/><axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="100" velocity="1"/>
  </joint>
  <joint name="j3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0.4 0.0 0.0" rpy="-0.3 0.2 0.6"/><axis xyz="0.3 0.4 0.866"/>
    <limit lower="-3.0" upper="3.0" effort="50" velocity="3"/>
  </joint>
  <joint name="tool_mount" type="fixed">
    <parent link="link3"/><child link="tool"/>
    <origin xyz="0 0.02 0.2" rpy="0.5 0 0"/>
  </joint>
</robot>
