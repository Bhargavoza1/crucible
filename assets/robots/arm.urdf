<?xml version="1.0"?>
<!-- Default sandbox robot: a 3-hinge arm on a fixed base (no sliders).
     Base yaw, shoulder pitch, elbow pitch, all with limits; a ball as the hand. -->
<robot name="arm">
  <mujoco><compiler fusestatic="false" discardvisual="true" balanceinertia="false"/></mujoco>
  <link name="base">
    <inertial><origin xyz="0 0 0.05"/><mass value="3.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.03"/></inertial>
  </link>
  <link name="turret">
    <inertial><origin xyz="0 0 0.05"/><mass value="1.5"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.004"/></inertial>
  </link>
  <link name="upper_arm">
    <inertial><origin xyz="0 0 0.2"/><mass value="1.2"/><inertia ixx="0.017" ixy="0" ixz="0" iyy="0.017" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="forearm">
    <inertial><origin xyz="0 0 0.17"/><mass value="0.8"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.0005"/></inertial>
    <collision><origin xyz="0 0 0.35"/><geometry><sphere radius="0.05"/></geometry></collision>
  </link>
  <joint name="base_yaw" type="revolute">
    <parent link="base"/><child link="turret"/>
    <origin xyz="0 0 0.1"/><axis xyz="0 0 1"/>
    <limit lower="-2.5" upper="2.5" effort="40" velocity="3"/>
  </joint>
  <joint name="shoulder" type="revolute">
    <parent link="turret"/><child link="upper_arm"/>
    <origin xyz="0 0 0.1"/><axis xyz="0 1 0"/>
    <limit lower="-1.6" upper="1.6" effort="40" velocity="3"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0 0 0.4"/><axis xyz="0 1 0"/>
    <limit lower="-2.4" upper="2.4" effort="20" velocity="3"/>
  </joint>
</robot>
